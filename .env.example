NODE_ENV=production
PORT=3000
TRUST_PROXY=1
REQUEST_TIMEOUT_MS=120000
HEADERS_TIMEOUT_MS=30000
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-luna
ANTONIO_NAME=Antonio
RATE_LIMIT_PER_MINUTE=60
SESSION_MAX_AGE_SECONDS=3600
REFRESH_MAX_AGE_SECONDS=2592000
COOKIE_SECURE=true

# Production database: PostgreSQL/Supabase is required by Antonio 5.
# Keep this secret.
DATABASE_URL=
# SUPABASE_DB_URL=  # alternative to DATABASE_URL
DB_POOL_MAX=10
DB_SSL=true
SQLITE_PATH=data/antonio.db

# Supabase Auth (server-side auth validation)
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=

# Google OAuth: Gmail + Calendar + Drive
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://YOUR-DOMAIN/api/integrations/google/callback
GOOGLE_SCOPES=https://www.googleapis.com/auth/gmail.readonly https://www.googleapis.com/auth/gmail.send https://www.googleapis.com/auth/calendar.events

# Telegram Bot
TELEGRAM_BOT_TOKEN=

# WhatsApp Cloud API
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_API_VERSION=v23.0

ENABLE_WEB_SEARCH=true
ENABLE_FILE_SEARCH=false
OPENAI_VECTOR_STORE_ID=

# Run the worker as a separate service/process in production.
WORKER_INTERVAL_MS=15000
# 32+ random characters; used to encrypt OAuth tokens at rest.
TOKEN_ENCRYPTION_KEY=
